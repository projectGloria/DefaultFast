// DefaultFast UI. Rust owns all state; this file is layout, styling and key routing.
// Top-bar geometry (36 px bar, 46 px caption buttons, 44 px icon zone) must match
// CAPTION_H / BUTTON_W / ICON_W in src/window.rs, which does the native hit-testing.
import { ListView, ScrollView, CheckBox, Palette } from "std-widgets.slint";

export struct ResultRow {
    kind: int, // 0 group header, 1 program, 2 file type, 3 protocol
    title: string,
    subtitle: string,
    icon: image,
    has-icon: bool,
}

export struct SupportRow {
    target: string,
    current: string,
    is-current: bool,
    checked: bool,
    icon: image,
    has-icon: bool,
}

export struct HandlerRow {
    name: string,
    detail: string,
    is-current: bool,
    recommended: bool,
    icon: image,
    has-icon: bool,
}

export struct IssueRow {
    title: string,
    detail: string,
    action: string, // button text; empty = informational
    severity: int,  // 0 info, 1 warning, 2 error
    admin: bool,    // fix needs UAC
}

export struct HistoryRow {
    title: string,
    when: string,
    undone: bool,
}

export global Theme {
    // Accent comes from Rust (HKCU\...\Explorer\Accent\AccentPalette) and updates live.
    in-out property <color> accent-light: #005fb8;
    in-out property <color> accent-dark: #60cdff;
    // "Segoe Fluent Icons" on Windows 11, "Segoe MDL2 Assets" on Windows 10 (same code points).
    in-out property <string> icon-font: "Segoe Fluent Icons";
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> accent: dark ? accent-dark : accent-light;
    out property <color> on-accent: dark ? #000000 : #ffffff;
    // Mica-like base: the software renderer can't show the real backdrop (see README).
    out property <color> background: dark ? #202020 : #f3f3f3;
    out property <color> card: dark ? #2b2b2b : #fbfbfb;
    out property <color> card-hover: dark ? #323232 : #f5f5f5;
    out property <color> control: dark ? #ffffff0f : #ffffffb3;
    out property <color> control-hover: dark ? #ffffff15 : #f9f9f980;
    out property <color> subtle-hover: dark ? #ffffff0f : #00000009;
    out property <color> subtle-pressed: dark ? #ffffff0a : #00000006;
    out property <color> stroke: dark ? #ffffff14 : #0000000f;
    out property <color> stroke-strong: dark ? #ffffff1f : #00000024;
    out property <color> text: dark ? #ffffff : #1b1b1b;
    out property <color> text-2: dark ? #ffffffc8 : #000000a0;
    out property <color> text-3: dark ? #ffffff8b : #00000072;
    out property <color> ok: dark ? #6ccb5f : #0f7b0f;
    out property <color> warn: dark ? #fce100 : #9d5d00;
    out property <color> bad: dark ? #ff99a4 : #c42b1c;
}

component Glyph inherits Text {
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
    // Icon-font code points are private-use characters: never read them out.
    accessible-label: "";
}

// Windows 11 style button. kind: 0 standard, 1 accent, 2 subtle (hyperlink-ish).
component Btn inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;
    callback clicked;
    forward-focus: fs;
    height: 32px;
    border-radius: 4px;
    background: !root.enabled ? (kind == 1 ? Theme.stroke-strong : transparent)
        : kind == 1 ? (ta.pressed ? Theme.accent.with-alpha(0.8) : ta.has-hover ? Theme.accent.with-alpha(0.9) : Theme.accent)
        : kind == 2 ? (ta.pressed ? Theme.subtle-pressed : ta.has-hover ? Theme.subtle-hover : transparent)
        : (ta.pressed ? Theme.subtle-pressed : ta.has-hover ? Theme.control-hover : Theme.control);
    border-width: kind == 0 ? 1px : 0px;
    border-color: Theme.stroke-strong;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    animate background { duration: 83ms; }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.kind == 2 ? 8px : 12px;
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;
        if root.glyph != "": Glyph {
            text: root.glyph;
            font-size: 14px;
            color: label.color;
        }
        label := Text {
            text: root.text;
            font-size: root.font-size;
            vertical-alignment: center;
            color: !root.enabled ? Theme.text-3 : root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.accent : Theme.text;
        }
    }
    Rectangle {
        x: -3px; y: -3px;
        width: parent.width + 6px; height: parent.height + 6px;
        border-radius: 7px;
        border-width: fs.has-focus ? 2px : 0px;
        border-color: Theme.text;
    }
}

component CaptionButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> close;
    in property <bool> outside-hover; // maximize: hover comes from WM_NCMOUSEMOVE
    callback clicked;
    width: 46px;
    property <bool> hot: ta.has-hover || outside-hover;
    background: close && hot ? (ta.pressed ? #c42b1ce6 : #c42b1c) : hot ? (ta.pressed ? Theme.subtle-pressed : Theme.subtle-hover) : transparent;
    animate background { duration: 83ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { clicked => { root.clicked(); } }
    Glyph {
        text: root.glyph;
        font-size: 10px;
        color: root.close && root.hot ? #ffffff : Theme.text;
    }
}

component AppMark inherits Rectangle {
    width: 16px; height: 16px;
    border-radius: 4px;
    background: Theme.accent-light;
    Glyph { text: "\u{E73E}"; font-size: 10px; color: #ffffff; }
}

component ResultItem inherits Rectangle {
    in property <ResultRow> data;
    in property <bool> selected;
    callback clicked;
    height: data.kind == 0 ? 30px : 46px;
    accessible-role: list-item;
    accessible-label: data.title + (data.subtitle != "" ? ", " + data.subtitle : "");
    accessible-item-selectable: data.kind != 0;
    accessible-item-selected: root.selected;
    accessible-action-default => { if (data.kind != 0) { root.clicked(); } }
    if data.kind == 0: Text {
        x: 14px;
        y: parent.height - self.height - 4px;
        text: data.title;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-2;
    }
    if data.kind != 0: Rectangle {
        x: 4px; width: parent.width - 8px;
        border-radius: 4px;
        background: root.selected ? Theme.subtle-hover : ta.has-hover ? Theme.subtle-pressed : transparent;
        ta := TouchArea { clicked => { root.clicked(); } }
        // Windows 11 selection pill.
        Rectangle {
            x: 0; width: 3px; height: root.selected ? 16px : 0px;
            border-radius: 1.5px;
            background: Theme.accent;
            animate height { duration: 120ms; easing: ease-out; }
        }
        HorizontalLayout {
            padding-left: 12px; padding-right: 10px;
            spacing: 12px;
            Rectangle {
                width: 24px;
                if data.has-icon: Image { source: data.icon; width: 24px; height: 24px; }
                if !data.has-icon: Glyph {
                    text: data.kind == 1 ? "\u{E71D}" : data.kind == 2 ? "\u{E8A5}" : "\u{E774}";
                    color: Theme.text-2;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: data.title; font-size: 14px; color: Theme.text; overflow: elide; }
                if data.subtitle != "": Text { text: data.subtitle; font-size: 12px; color: Theme.text-3; overflow: elide; }
            }
        }
    }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.stroke;
}

component Header inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> glyph;
    spacing: 12px;
    Rectangle {
        width: 40px; height: 40px;
        if root.has-icon: Image { source: root.icon; width: 32px; height: 32px; }
        if !root.has-icon: Glyph { text: root.glyph; font-size: 28px; color: Theme.text-2; }
    }
    VerticalLayout {
        alignment: center;
        Text { text: root.title; font-size: 20px; font-weight: 600; color: Theme.text; overflow: elide; accessible-role: text; }
        if root.subtitle != "": Text { text: root.subtitle; font-size: 12px; color: Theme.text-3; overflow: elide; }
    }
}

component SupportItem inherits Rectangle {
    in property <SupportRow> data;
    in property <bool> selected;
    callback toggled;
    callback clicked;
    height: 40px;
    border-radius: 4px;
    background: selected ? Theme.subtle-hover : transparent;
    accessible-role: checkbox;
    accessible-checked: data.checked;
    accessible-label: data.target + ", currently " + data.current;
    accessible-action-default => { root.toggled(); }
    TouchArea { clicked => { root.clicked(); root.toggled(); } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 20px;
            Rectangle {
                width: 18px; height: 18px;
                border-radius: 4px;
                background: data.checked ? Theme.accent : Theme.control;
                border-width: data.checked ? 0px : 1px;
                border-color: Theme.text-3;
                if data.checked: Glyph { text: "\u{E73E}"; font-size: 12px; color: Theme.on-accent; }
            }
        }
        Rectangle {
            width: 20px;
            if data.has-icon: Image { source: data.icon; width: 20px; height: 20px; }
        }
        Text { text: data.target; min-width: 70px; font-size: 14px; color: Theme.text; vertical-alignment: center; }
        Text {
            text: data.is-current ? "Already the default" : "Now: " + data.current;
            horizontal-stretch: 1;
            font-size: 12px;
            color: data.is-current ? Theme.ok : Theme.text-3;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component HandlerItem inherits Rectangle {
    in property <HandlerRow> data;
    in property <bool> selected;
    callback set-default;
    callback clicked;
    height: 52px;
    border-radius: 4px;
    background: selected ? Theme.subtle-hover : transparent;
    accessible-role: list-item;
    accessible-label: data.name + (data.is-current ? ", current default" : "");
    accessible-item-selected: root.selected;
    TouchArea { clicked => { root.clicked(); } double-clicked => { root.set-default(); } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        spacing: 12px;
        Rectangle {
            width: 28px;
            if data.has-icon: Image { source: data.icon; width: 28px; height: 28px; }
            if !data.has-icon: Glyph { text: "\u{E71D}"; color: Theme.text-2; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: data.name; font-size: 14px; color: Theme.text; overflow: elide; }
            Text {
                text: data.detail;
                font-size: 12px;
                color: Theme.text-3;
                overflow: elide;
            }
        }
        if data.is-current: HorizontalLayout {
            spacing: 4px;
            Glyph { text: "\u{E73E}"; font-size: 12px; color: Theme.ok; }
            Text { text: "Current"; font-size: 12px; color: Theme.ok; vertical-alignment: center; }
        }
        if !data.is-current: VerticalLayout {
            alignment: center;
            Btn { text: "Set default"; clicked => { root.set-default(); } }
        }
    }
}

component IssueItem inherits Card {
    in property <IssueRow> data;
    callback fix;
    height: max(64px, lay.preferred-height);
    accessible-role: list-item;
    accessible-label: data.title + ". " + data.detail;
    lay := HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Glyph {
            width: 20px;
            text: data.severity == 2 ? "\u{EA39}" : data.severity == 1 ? "\u{E7BA}" : "\u{E946}";
            color: data.severity == 2 ? Theme.bad : data.severity == 1 ? Theme.warn : Theme.text-2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: data.title; font-size: 14px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: data.detail; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
        }
        if data.action != "": VerticalLayout {
            alignment: center;
            Btn { text: data.action; glyph: data.admin ? "\u{EA18}" : ""; clicked => { root.fix(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "DefaultFast";
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 400px;
    background: Theme.background;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;
    forward-focus: search-input;

    in property <string> version;
    in property <bool> is-max;
    in property <bool> max-hover;

    in-out property <string> query;
    in property <[ResultRow]> results;
    in-out property <int> selected: -1;
    in property <length> selected-y;
    in property <length> selected-h;
    in property <int> scroll-results;
    in property <string> results-message;
    in property <int> view: 0; // 0 welcome, 1 program, 2 file type/protocol, 3 repair, 4 history
    in property <bool> busy;
    in property <string> status-text;

    in property <string> d-title;
    in property <string> d-subtitle;
    in property <image> d-icon;
    in property <bool> d-has-icon;
    in property <string> d-glyph: "\u{E71D}";

    in property <[SupportRow]> supports;
    in-out property <int> support-selected: 0;
    in property <int> checked-count;
    in property <string> program-note;

    in property <string> current-default;
    in property <[HandlerRow]> handlers;
    in-out property <int> handler-selected: 0;
    in property <bool> can-browse: true;

    in property <[IssueRow]> issues;
    in property <string> health-text: "Checking…";
    in property <int> health-state: 0; // 0 checking, 1 all good, 2 issues
    in property <int> fixable-count;

    in property <[HistoryRow]> history;

    in property <bool> toast-visible;
    in property <string> toast-text;
    in property <int> toast-kind; // 0 success, 1 error, 2 info
    in property <bool> toast-undo;
    in property <bool> toast-settings;

    in property <bool> confirm-visible;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <bool> confirm-shield;
    in-out property <bool> about-visible;
    // Bumped by Rust after Enter opens a result: moves keyboard focus into the detail list.
    in property <int> detail-focus;

    callback query-edited(string);
    callback move-selection(int);
    callback activate(int);
    callback open-selected();
    callback escape-pressed();
    callback example(string);
    callback toggle-support(int);
    callback select-all();
    callback select-none();
    callback apply-selected();
    callback apply-all();
    callback add-target(string);
    callback set-handler(int);
    callback browse();
    callback open-settings();
    callback show-repair();
    callback run-health();
    callback fix-issue(int);
    callback fix-all();
    callback show-history();
    callback undo-last();
    callback restore(int);
    callback open-backups();
    callback toast-undo-clicked();
    callback toast-settings-clicked();
    callback toast-dismiss();
    callback confirm-accept();
    callback confirm-cancel();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback system-menu();

    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }
    function ensure-visible() {
        if (root.selected >= 0) {
            if (root.selected-y < -results-list.content-y) {
                results-list.content-y = -root.selected-y;
            } else if (root.selected-y + root.selected-h > -results-list.content-y + results-list.visible-height) {
                results-list.content-y = -(root.selected-y + root.selected-h - results-list.visible-height);
            }
        }
    }
    changed selected-y => { ensure-visible(); }
    changed scroll-results => { ensure-visible(); }

    // Global shortcuts. capture-* runs before the focused widget sees the key.
    root-scope := FocusScope {
        capture-key-pressed(e) => {
            if (e.modifiers.control && (e.text == "k" || e.text == "K")) {
                root.focus-search();
                return accept;
            }
            if (!root.busy && !root.confirm-visible && !root.about-visible && e.modifiers.control && e.text == Key.Return) {
                if (root.view == 1) { root.apply-selected(); }
                if (root.view == 2) { root.set-handler(root.handler-selected); }
                return accept;
            }
            if (e.text == Key.Escape && (root.confirm-visible || root.about-visible)) {
                if (root.confirm-visible) { root.confirm-cancel(); }
                root.about-visible = false;
                return accept;
            }
            reject
        }
        key-pressed(e) => {
            // Reached only when no text field consumed the key.
            if (e.text == "/") {
                root.focus-search();
                return accept;
            }
            if (e.text == Key.Escape) {
                // From the detail pane: back to the search box, keeping the query.
                root.focus-search();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // ---------------------------------------------------------------- top bar
            Rectangle {
                height: 36px;
                accessible-role: window-title-bar;
                accessible-label: "DefaultFast";
                HorizontalLayout {
                    // Icon zone: HTCLIENT (window.rs ICON_W), click = system menu, hover = version.
                    icon-zone := Rectangle {
                        width: 44px;
                        AppMark { }
                        icon-ta := TouchArea { clicked => { root.system-menu(); } }
                        accessible-role: button;
                        accessible-label: "DefaultFast " + root.version + ", window menu";
                    }
                    Text {
                        text: "DefaultFast";
                        font-size: 12px;
                        color: Theme.text-2;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    CaptionButton { glyph: "\u{E921}"; label: "Minimize"; clicked => { root.minimize(); } }
                    CaptionButton {
                        glyph: root.is-max ? "\u{E923}" : "\u{E922}";
                        label: root.is-max ? "Restore" : "Maximize";
                        outside-hover: root.max-hover;
                        clicked => { root.toggle-maximize(); }
                    }
                    CaptionButton { glyph: "\u{E8BB}"; label: "Close"; close: true; clicked => { root.close-window(); } }
                }
            }

            // ---------------------------------------------------------------- search box
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                search-box := Rectangle {
                    height: 44px;
                    border-radius: 6px;
                    background: search-input.has-focus ? Theme.card : Theme.control;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    Rectangle {
                        y: parent.height - 2px; height: 2px;
                        x: 6px; width: parent.width - 12px;
                        background: search-input.has-focus ? Theme.accent : transparent;
                    }
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 6px;
                        spacing: 10px;
                        Glyph { text: "\u{E721}"; width: 18px; color: Theme.text-2; }
                        Rectangle {
                            horizontal-stretch: 1;
                            search-scope := FocusScope {
                                capture-key-pressed(e) => {
                                    if (e.text == Key.DownArrow) { root.move-selection(1); return accept; }
                                    if (e.text == Key.UpArrow) { root.move-selection(-1); return accept; }
                                    if (e.text == Key.Return && !e.modifiers.control) { root.open-selected(); return accept; }
                                    if (e.text == Key.Escape && !root.confirm-visible && !root.about-visible) {
                                        root.escape-pressed();
                                        return accept;
                                    }
                                    reject
                                }
                                search-input := TextInput {
                                    text <=> root.query;
                                    font-size: 16px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    selection-background-color: Theme.accent.with-alpha(0.4);
                                    accessible-label: "Search programs, file types and protocols";
                                    edited => { root.query-edited(self.text); }
                                }
                            }
                            if root.query == "": Text {
                                width: 100%; height: 100%;
                                text: "Search programs, file types (.pdf) or protocols (https)";
                                font-size: 16px;
                                color: Theme.text-3;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                        if root.query != "": VerticalLayout {
                            alignment: center;
                            Btn {
                                kind: 2; glyph: "\u{E711}"; text: "";
                                width: 32px;
                                accessible-label: "Clear search";
                                clicked => {
                                    root.query = "";
                                    root.query-edited("");
                                    root.focus-search();
                                }
                            }
                        }
                    }
                }
            }

            // ---------------------------------------------------------------- body
            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: 8px; padding-right: 12px;
                spacing: 8px;

                // Results column
                Rectangle {
                    min-width: 240px;
                    max-width: 340px;
                    horizontal-stretch: 0.75;
                    results-list := ListView {
                        accessible-role: list;
                        accessible-label: "Results";
                        for r[i] in root.results: ResultItem {
                            data: r;
                            selected: i == root.selected;
                            clicked => {
                                root.selected = i;
                                root.activate(i);
                            }
                        }
                    }
                    if root.results.length == 0: VerticalLayout {
                        padding: 16px;
                        alignment: start;
                        Text {
                            text: root.results-message;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Theme.text-2;
                        }
                    }
                }

                // Detail pane
                Card {
                    horizontal-stretch: 1;
                    clip: true;

                    // Welcome
                    if root.view == 0: VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        alignment: center;
                        Glyph { text: "\u{E721}"; font-size: 40px; color: Theme.accent; }
                        Text {
                            text: "Find a program, a file type or a protocol";
                            font-size: 18px; font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Then set it as the default in one click. Every change is backed up and can be undone.";
                            font-size: 13px;
                            color: Theme.text-2;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            for ex in [".pdf", ".mp4", "https", "vlc"]: Btn {
                                text: ex;
                                clicked => { root.example(ex); }
                            }
                        }
                    }

                    // Program
                    if root.view == 1: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Header { title: root.d-title; subtitle: root.d-subtitle; icon: root.d-icon; has-icon: root.d-has-icon; glyph: "\u{E71D}"; }
                        if root.supports.length > 0: HorizontalLayout {
                            spacing: 4px;
                            Btn { kind: 1; enabled: !root.busy; text: "Make default for everything (" + root.supports.length + ")"; clicked => { root.apply-all(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.supports.length > 0: HorizontalLayout {
                            spacing: 2px;
                            Text {
                                text: "Choose what to change:";
                                font-size: 12px;
                                color: Theme.text-3;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Btn { kind: 2; height: 26px; font-size: 12px; text: "Select all"; clicked => { root.select-all(); } }
                            Btn { kind: 2; height: 26px; font-size: 12px; text: "Select none"; clicked => { root.select-none(); } }
                        }
                        if root.program-note != "": Text {
                            text: root.program-note;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Theme.text-2;
                        }
                        support-scope := FocusScope {
                            property <int> req: root.detail-focus;
                            property <int> sel: root.support-selected;
                            changed req => { self.focus(); }
                            changed sel => {
                                if (self.sel >= 0) {
                                    if (self.sel * 40px < -supports-list.content-y) {
                                        supports-list.content-y = -self.sel * 40px;
                                    } else if ((self.sel + 1) * 40px > -supports-list.content-y + supports-list.visible-height) {
                                        supports-list.content-y = -((self.sel + 1) * 40px - supports-list.visible-height);
                                    }
                                }
                            }
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-label: "File types and protocols";
                            key-pressed(e) => {
                                if (root.supports.length > 0 && e.text == Key.DownArrow) { root.support-selected = min(root.support-selected + 1, root.supports.length - 1); return accept; }
                                if (root.supports.length > 0 && e.text == Key.UpArrow) { root.support-selected = max(root.support-selected - 1, 0); return accept; }
                                if (root.supports.length > 0 && e.text == " ") { root.toggle-support(root.support-selected); return accept; }
                                reject
                            }
                            Rectangle {
                                border-radius: 4px;
                                border-width: support-scope.has-focus ? 1px : 0px;
                                border-color: Theme.accent;
                                supports-list := ListView {
                                    for s[i] in root.supports: SupportItem {
                                        data: s;
                                        selected: i == root.support-selected && support-scope.has-focus;
                                        clicked => { root.support-selected = i; support-scope.focus(); }
                                        toggled => { root.toggle-support(i); }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 32px;
                                border-radius: 4px;
                                background: Theme.control;
                                border-width: 1px;
                                border-color: Theme.stroke-strong;
                                add-input := TextInput {
                                    x: 10px; width: parent.width - 20px;
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accessible-label: "Add a file type, for example .txt";
                                    accepted => { root.add-target(self.text); self.text = ""; }
                                }
                                if add-input.text == "": Text {
                                    x: 10px;
                                    height: 100%;
                                    text: "Add type (.txt)";
                                    font-size: 13px;
                                    color: Theme.text-3;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            Btn { text: "Add"; clicked => { root.add-target(add-input.text); add-input.text = ""; } }
                            Btn {
                                kind: 1;
                                enabled: root.checked-count > 0 && !root.busy;
                                text: "Set as default for selected (" + root.checked-count + ")";
                                clicked => { root.apply-selected(); }
                            }
                        }
                    }

                    // File type / protocol
                    if root.view == 2: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Header { title: root.d-title; subtitle: root.d-subtitle; icon: root.d-icon; has-icon: root.d-has-icon; glyph: root.d-glyph; }
                        Card {
                            height: 52px;
                            background: Theme.control;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                spacing: 6px;
                                Text { text: "Current default:"; color: Theme.text-2; font-size: 13px; vertical-alignment: center; }
                                Text { text: root.current-default; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                        Text { text: "Apps that can open it"; font-size: 13px; font-weight: 600; color: Theme.text-2; }
                        handler-scope := FocusScope {
                            property <int> req: root.detail-focus;
                            property <int> sel: root.handler-selected;
                            changed req => { self.focus(); }
                            changed sel => {
                                if (self.sel >= 0) {
                                    if (self.sel * 52px < -handlers-list.content-y) {
                                        handlers-list.content-y = -self.sel * 52px;
                                    } else if ((self.sel + 1) * 52px > -handlers-list.content-y + handlers-list.visible-height) {
                                        handlers-list.content-y = -((self.sel + 1) * 52px - handlers-list.visible-height);
                                    }
                                }
                            }
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-label: "Apps that can open it";
                            key-pressed(e) => {
                                if (root.handlers.length > 0 && e.text == Key.DownArrow) { root.handler-selected = min(root.handler-selected + 1, root.handlers.length - 1); return accept; }
                                if (root.handlers.length > 0 && e.text == Key.UpArrow) { root.handler-selected = max(root.handler-selected - 1, 0); return accept; }
                                if (root.handlers.length > 0 && !root.busy && !root.confirm-visible && e.text == Key.Return) { root.set-handler(root.handler-selected); return accept; }
                                reject
                            }
                            Rectangle {
                                border-radius: 4px;
                                border-width: handler-scope.has-focus ? 1px : 0px;
                                border-color: Theme.accent;
                                handlers-list := ListView {
                                    for h[i] in root.handlers: HandlerItem {
                                        data: h;
                                        selected: i == root.handler-selected && handler-scope.has-focus;
                                        clicked => { root.handler-selected = i; handler-scope.focus(); }
                                        set-default => { root.set-handler(i); }
                                    }
                                }
                                if root.handlers.length == 0: Text {
                                    text: "No installed app says it can open this. Use Browse to pick one.";
                                    wrap: word-wrap;
                                    color: Theme.text-3;
                                    font-size: 13px;
                                    vertical-alignment: top;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            if root.can-browse: Btn { glyph: "\u{E8B7}"; text: "Browse for another program…"; clicked => { root.browse(); } }
                            Rectangle { horizontal-stretch: 1; }
                            Btn { kind: 2; glyph: "\u{E713}"; text: "Windows Settings"; clicked => { root.open-settings(); } }
                        }
                    }

                    // Repair
                    if root.view == 3: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Header {
                            title: "Health check";
                            subtitle: root.health-text;
                            glyph: root.health-state == 2 ? "\u{E90F}" : "\u{E930}";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Btn { kind: 1; text: "Fix all (" + root.fixable-count + ")"; enabled: root.fixable-count > 0 && !root.busy; clicked => { root.fix-all(); } }
                            Btn { text: "Check again"; enabled: !root.busy; clicked => { root.run-health(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        ListView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-label: "Problems found";
                            for issue[i] in root.issues: VerticalLayout {
                                padding-bottom: 6px;
                                IssueItem { data: issue; fix => { root.fix-issue(i); } }
                            }
                        }
                        if root.issues.length == 0 && root.health-state == 1: Text {
                            text: "All good. File types like .bat, .exe and .lnk open with the right Windows handler.";
                            wrap: word-wrap; color: Theme.text-2; font-size: 13px;
                        }
                    }

                    // History
                    if root.view == 4: VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Header { title: "History"; subtitle: "Each change saved a .reg backup first. The 50 newest are kept."; glyph: "\u{E81C}"; }
                        HorizontalLayout {
                            spacing: 8px;
                            Btn { kind: 1; glyph: "\u{E7A7}"; text: "Undo last change"; enabled: !root.busy && root.history.length > 0; clicked => { root.undo-last(); } }
                            Btn { glyph: "\u{E8B7}"; text: "Open backup folder"; clicked => { root.open-backups(); } }
                        }
                        ListView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-label: "Backups";
                            for h[i] in root.history: Rectangle {
                                height: 52px;
                                accessible-role: list-item;
                                accessible-label: h.title + ", " + h.when;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: h.title; font-size: 13px; color: h.undone ? Theme.text-3 : Theme.text; overflow: elide; }
                                        Text { text: h.when + (h.undone ? " · undone" : ""); font-size: 12px; color: Theme.text-3; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Btn { text: "Restore"; enabled: !root.busy; clicked => { root.restore(i); } }
                                    }
                                }
                            }
                        }
                        if root.history.length == 0: Text {
                            text: "No changes yet. Backups appear here after your first change.";
                            color: Theme.text-3; font-size: 13px; wrap: word-wrap;
                        }
                    }
                }
            }

            // ---------------------------------------------------------------- footer
            HorizontalLayout {
                height: 34px;
                padding: 4px;
                padding-left: 8px; padding-right: 8px;
                spacing: 4px;
                Btn {
                    kind: 2;
                    font-size: 12px;
                    height: 26px;
                    glyph: root.health-state == 0 ? "\u{E916}" : root.health-state == 1 ? "\u{E930}" : "\u{E7BA}";
                    text: root.health-text;
                    clicked => { root.show-repair(); }
                }
                Text {
                    text: root.status-text;
                    font-size: 12px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Btn { kind: 2; font-size: 12px; height: 26px; glyph: "\u{E81C}"; text: "History"; clicked => { root.show-history(); } }
                Btn { kind: 2; font-size: 12px; height: 26px; glyph: "\u{E946}"; text: "About"; clicked => { root.about-visible = true; } }
            }
        }

        // ---------------------------------------------------------------- version tooltip
        if icon-ta.has-hover: Rectangle {
            x: 8px; y: 38px;
            width: tip.preferred-width + 16px;
            height: 26px;
            border-radius: 4px;
            background: Theme.dark ? #2c2c2c : #ffffff;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000033;
            tip := Text { text: "DefaultFast " + root.version; font-size: 12px; color: Theme.text; }
        }

        // ---------------------------------------------------------------- toast
        if root.toast-visible: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 34px - self.height - 10px;
            width: min(parent.width - 48px, 600px);
            height: toast-lay.preferred-height;
            border-radius: 8px;
            background: Theme.dark ? #2c2c2c : #ffffff;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 4px;
            accessible-role: text;
            accessible-label: root.toast-text;
            toast-lay := HorizontalLayout {
                padding: 10px;
                padding-left: 14px;
                spacing: 10px;
                Glyph {
                    width: 18px;
                    text: root.toast-kind == 0 ? "\u{E930}" : root.toast-kind == 1 ? "\u{EA39}" : "\u{E946}";
                    color: root.toast-kind == 0 ? Theme.ok : root.toast-kind == 1 ? Theme.bad : Theme.accent;
                }
                Text {
                    text: root.toast-text;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    font-size: 13px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if root.toast-settings: Btn { text: "Open Settings"; clicked => { root.toast-settings-clicked(); } }
                if root.toast-undo: Btn { text: "Undo"; clicked => { root.toast-undo-clicked(); } }
                Btn { kind: 2; glyph: "\u{E711}"; text: ""; width: 32px; accessible-label: "Dismiss"; clicked => { root.toast-dismiss(); } }
            }
        }

        // ---------------------------------------------------------------- confirm dialog
        if root.confirm-visible: Rectangle {
            background: #00000066;
            TouchArea { }
            Card {
                width: min(parent.width - 48px, 440px);
                height: dlg.preferred-height;
                background: Theme.dark ? #2b2b2b : #ffffff;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                dlg := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text { text: root.confirm-title; font-size: 18px; font-weight: 600; color: Theme.text; wrap: word-wrap; accessible-role: text; }
                    Text { text: root.confirm-text; font-size: 13px; color: Theme.text-2; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        ok-btn := Btn { kind: 1; glyph: root.confirm-shield ? "\u{EA18}" : ""; text: root.confirm-ok; clicked => { root.confirm-accept(); } }
                        Btn { text: "Cancel"; clicked => { root.confirm-cancel(); } }
                    }
                }
                init => { ok-btn.focus(); }
            }
        }

        // ---------------------------------------------------------------- about
        if root.about-visible: Rectangle {
            background: #00000066;
            TouchArea { clicked => { root.about-visible = false; } }
            Card {
                width: min(parent.width - 48px, 380px);
                height: about-lay.preferred-height;
                background: Theme.dark ? #2b2b2b : #ffffff;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                about-lay := VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        AppMark { width: 24px; height: 24px; }
                        Text { text: "DefaultFast"; font-size: 20px; font-weight: 600; color: Theme.text; }
                    }
                    Text { text: "Version " + root.version; font-size: 13px; color: Theme.text-2; accessible-role: text; }
                    Text {
                        text: "Set and repair Windows default apps. No network access, no telemetry. Backups and the log live in %LOCALAPPDATA%\\DefaultFast.";
                        font-size: 13px; color: Theme.text-2; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        close-btn := Btn { kind: 1; text: "Close"; clicked => { root.about-visible = false; } }
                    }
                }
                init => { close-btn.focus(); }
            }
        }
    }
}
